# Copy to .env and fill in. .env is gitignored - never commit it.
# cp .env.example .env   (PowerShell: Copy-Item .env.example .env)

BASE_URL=http://localhost:8080

# Set these during the OrangeHRM install wizard on first boot.
# Single-quote any value containing # or $. Unquoted, dotenv reads # as the start
# of a comment and silently truncates the value (Pass123# becomes Pass123, and
# you get "Invalid credentials" with no error anywhere). Inside double quotes $
# expands as a variable; single quotes are literal, so prefer them for passwords.
ORANGEHRM_ADMIN_USER=Admin
ORANGEHRM_ADMIN_PASSWORD='changeme'
ORANGEHRM_FIRST_NAME=Name
ORANGEHRM_LAST_NAME=Surname
