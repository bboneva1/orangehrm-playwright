{
  "compilerOptions": {
    // Target/lib: Node 20+ supports modern JS, so no need to downlevel.
    "target": "ES2022",
    "lib": ["ES2022", "DOM"], // DOM because page.evaluate() runs browser-side code
    "module": "ESNext",
    "moduleResolution": "bundler",

    // Strictness. Turn these on now - retrofitting strict mode later is painful.
    "strict": true,
    "noUncheckedIndexedAccess": true, // arr[0] is T | undefined. Catches real bugs in test data.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,

    // We never emit JS - Playwright transpiles specs itself. tsc is a type checker only.
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true, // don't typecheck node_modules; big speedup
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,

    // Path alias so specs import from '@pages/...' instead of '../../../pages/...'
    // No baseUrl: it's deprecated, and paths hasn't needed it since TS 4.1.
    // Leading ./ makes each target relative to this file's folder.
    "paths": {
      "@pages/*": ["./src/pages/*"],
      "@fixtures/*": ["./src/fixtures/*"],
      "@utils/*": ["./src/utils/*"]
    },
    "types": ["node"]
  },
  "include": ["src", "tests", "playwright.config.ts", "eslint.config.js"],
  "exclude": ["node_modules", "test-results", "playwright-report"]
}
